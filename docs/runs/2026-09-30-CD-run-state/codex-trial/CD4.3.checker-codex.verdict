criterion i: PASS
    attack: Apply each specified regression alone in a disposable copy and run the relevant shipped suite.
    command: python3 - <<'PY'
        from pathlib import Path
        from concurrent.futures import ThreadPoolExecutor
        import tempfile, shutil, subprocess
        root=Path('/work')
        cases=[('stats-from-one','gate','for (( a=0; a<=last; a++ )); do','for (( a=1; a<=last; a++ )); do'),('stats-invalid-second','gate','if [[ -f "$f" ]] && load_verdict "$f" "$1" "$2"; then echo "$_vv"; else echo none; fi','if [[ -f "$f" ]]; then echo FAIL; else echo none; fi'),('skip-locale','gate','LC_ALL=C sed "s/^$2:[[:space:]]*//"','sed "s/^$2:[[:space:]]*//"'),('parse-no-nul','parse','  if (buf.includes(0)) return null;','')]
        def run(c):
         name,typ,old,new=c; d=Path(tempfile.mkdtemp(prefix='cd4-mut-',dir=root))
         try:
          if typ=='gate':
           (d/'swarm').mkdir(); (d/'smoketest/gate').mkdir(parents=True)
           shutil.copy2(root/'swarm/gate.sh',d/'swarm/gate.sh')
           for f in ['_lib.sh','run_check.sh']: shutil.copy2(root/'smoketest/gate'/f,d/'smoketest/gate'/f)
           p=d/'swarm/gate.sh'; cmd=['bash',str(d/'smoketest/gate/run_check.sh')]
          else:
           shutil.copytree(root/'dashboard/lib',d/'lib'); shutil.copytree(root/'dashboard/test',d/'test')
           p=d/'lib/parse.mjs'; cmd=['node','--test','--test-name-pattern=codex differential|NUL',str(d/'test/parse.test.mjs')]
          s=p.read_text(); assert old in s; p.write_text(s.replace(old,new,1))
          q=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=180)
          print(name,q.returncode,sum(x.startswith(('FAIL -','not ok')) for x in q.stdout.splitlines()))
         finally: shutil.rmtree(d)
        with ThreadPoolExecutor(max_workers=4) as ex:
         for out in ex.map(run,cases): pass
        PY
    result: The scratch mutations failed their shipped suites: attempt-1 stats had 1 failed assertion; invalid checker-second stats had 8; caller-locale skip parsing had 12; removed dashboard NUL check had 1. A separate scratch run bypassing tier-1 Codex verdict validation produced 18 failed gate assertions, including acceptance of a verdict beside a skip.
