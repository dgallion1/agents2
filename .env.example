# Copy to .env and fill in real values. Never commit .env.
# Used by docker compose / swarm/start.sh for the LiteLLM gateway.

# Required — all cloud models route through OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Optional — only the worker-zai direct fallback (not used by default agents)
GLM_API_KEY=

# Optional — compose defaults to sk-swarm-local if unset
LITELLM_MASTER_KEY=sk-swarm-local

# Required for worker-local — the Spark's vLLM OpenAI endpoint and its --api-key.
# Use the tailnet name, not spark.local: the LAN address is unreachable from the
# gateway container. Confirm the served model id with
#   curl -H "Authorization: Bearer $SPARK_API_KEY" $SPARK_API_BASE/models
SPARK_API_BASE=http://<host>.<your-tailnet>.ts.net:8000/v1
SPARK_API_KEY=
